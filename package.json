{
  "name": "d3-audio",
  "version": "1.0.0",
  "description": "D3 module for audio-visual data sonification and rhythmic choreography mapped to Tone.js timelines",
  "main": "dist/d3-audio.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src": "./src/index.js",
    "./src/audio": "./src/audio/index.js",
    "./src/movements": "./src/movements/index.js",
    "./src/musical": "./src/musical/index.js",
    "./src/scales": "./src/scales/index.js",
    "./src/timeline": "./src/timeline/index.js",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=80 --test-coverage-branches=60 --test-coverage-functions=80 --test-reporter=spec test/*.test.js",
    "lint": "eslint .",
    "start": "python3 -m http.server 3000",
    "serve": "node scripts/serve.js"
  },
  "keywords": [
    "d3",
    "d3-module",
    "d3-audio",
    "sonification",
    "tonejs",
    "web-audio",
    "animation",
    "choreography",
    "data-visualization"
  ],
  "homepage": "https://dmuldrew.github.io/d3-audio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmuldrew/d3-audio.git"
  },
  "author": "Daniel Muldrew",
  "license": "MIT",
  "peerDependencies": {
    "d3": "^7.0.0",
    "tone": "^14.8.0 || ^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
